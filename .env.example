# 模拟后端的端口（默认 8787）
API_PORT=8787

# 额外放行的前端来源，逗号分隔。
# 默认已放行 localhost:5173/4173 以及任意 https://*.github.io
# 如果你给 Pages 绑定了自定义域名，把它加到这里：
# ALLOWED_ORIGINS=https://demo.example.com
ALLOWED_ORIGINS=

# token 有效期（秒），默认 2 小时
TOKEN_TTL=7200

# 关闭 *.github.io 的自动放行（生产环境建议显式白名单）
# ALLOW_GITHUB_PAGES=false

# ---- 前端（Vite）构建期变量 ----
# 指向 Mock API / 真实 API 的地址；留空则使用同源 /api（本地 dev 代理）
# 本地调试 Pages 构建产物时：http://127.0.0.1:8787
# 部署到 Pages 时：在仓库 Actions Variables 里配置同一个名字
# VITE_API_BASE_URL=http://127.0.0.1:8787
